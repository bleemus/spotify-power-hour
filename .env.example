# Spotify app Client ID (public, not a secret) from developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=

# Optional. Origin whose /callback is registered with Spotify (the production site).
# When set and different from the current origin, login goes through the production
# /callback relay — this is how PR preview environments sign in.
# Leave unset locally to use http://127.0.0.1:5173/callback directly.
VITE_AUTH_REDIRECT_ORIGIN=
